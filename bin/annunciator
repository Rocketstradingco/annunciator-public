#!/usr/bin/env python3
"""Run Annunciator from this checkout without installing it.

Generated service units and AI-agent registrations call this file by its
absolute path, so they work from any working directory.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from annunciator.cli import main  # noqa: E402

raise SystemExit(main())
