// Every dashboard setting with its default value. Generated by tools/build_docs.py
// from annunciator/config/schema.py; see docs/configuration.md for the reference.
//
// Copy what you need into config/local.json. Keys you leave out keep these defaults.
// Comments (// and /* */) are allowed in configuration files.
{
  "$schema": "./schema.json",
  // TCP port the dashboard listens on.
  "port": 18160,
  // Listen address. 127.0.0.1 is this computer only; use a LAN address or 0.0.0.0 to let phones
  // and other computers connect.
  "bind": "127.0.0.1",
  // Server log verbosity.
  "log_level": "INFO",
  // Private state: control key, speed-test history, memory-router files. Keep it out of Git.
  "data_dir": "runtime",
  // Folder the web client is served from.
  "web_root": "web",
  // Folder holding a staged Android update (release.json + annunciator.apk).
  "updates_dir": "updates",
  // File holding the control key. Default: <data_dir>/control.key. ANNUNCIATOR_CONTROL_KEY
  // supplies the key itself and wins over the file.
  "control_key_file": null,
  // Access-Control-Allow-Origin sent with every response. * lets the Android app and other
  // origins read the API; set your own origin or "" to omit the header.
  "cors_origin": "*",
  // Seconds between TCP/HTTP availability probes.
  "interval_s": 10,
  // Availability samples kept per host and service (memory only; reset on restart).
  "history": 90,
  // Enable the key-protected write endpoints: Wake-on-LAN, power, containers, speed tests.
  "allow_controls": false,
  // Branding. Names and colour shown in the header, page title and Overview.
  "branding": {
    // Dashboard name.
    "name": "Annunciator",
    // Header subtitle.
    "subtitle": "SYSTEM TELEMETRY",
    // Accent colour as #RRGGBB. Unset keeps the built-in orange.
    "accent": null
  },
  // Web client. Settings the server passes to every browser and phone through /api/state.
  "ui": {
    // Seconds between the client's /api/state refreshes.
    "poll_s": 5
  },
  // Probes. The TCP connect (machines) and HTTP GET (services) availability checks.
  "probe": {
    // Seconds before a TCP or HTTP probe counts as failed.
    "timeout_s": 3,
    // Probes run in parallel per cycle.
    "workers": 16
  },
  // Telemetry. CPU, memory, disk, temperature and network readings collected from machines that
  // set telemetry.
  "telemetry": {
    // Seconds between collections.
    "interval_s": 15,
    // CPU and network samples kept per machine for charts.
    "history": 60,
    // Seconds a Linux collection (local or SSH) may take.
    "timeout_s": 15,
    // Seconds a Windows PowerShell collection may take.
    "windows_timeout_s": 30
  },
  // Container polling. Inventory of Docker or Podman containers on machines that set
  // containers.
  "container_poll": {
    // Seconds between inventory polls.
    "interval_s": 30,
    // Seconds an inventory command may take.
    "timeout_s": 20,
    // Seconds a start/stop/restart may take.
    "action_timeout_s": 60
  },
  // Resource thresholds. Fractions (0-1) at which disk and memory raise warnings. The web
  // client uses the same numbers.
  "thresholds": {
    // Disk use that raises a warning.
    "disk_warn": 0.8,
    // Disk use that raises a critical alert.
    "disk_crit": 0.9,
    // Memory use that raises a warning.
    "mem_warn": 0.9
  },
  // Wake-on-LAN. Magic packets for machines that set mac (requires allow_controls).
  "wake": {
    // Destination address for magic packets; use your subnet's broadcast if needed.
    "broadcast": "255.255.255.255",
    // Local address to send from, to pick the outgoing interface.
    "source": null,
    // UDP port for magic packets.
    "port": 9,
    // Seconds a machine shows as waking after a packet.
    "window_s": 180,
    // Seconds before another packet may be sent to the same machine.
    "cooldown_s": 10
  },
  // SSH. How the server reaches machines for telemetry, containers and power. It uses the
  // running account's own SSH setup unless ssh.config names a dedicated file.
  "ssh": {
    // Dedicated ssh_config file (the wizard writes <data_dir>/ssh/config).
    "config": null,
    // SSH ConnectTimeout.
    "connect_timeout_s": 4,
    // Seconds an idle multiplexed connection stays open (ControlPersist). 0 disables
    // multiplexing.
    "control_persist_s": 180,
    // ControlPath for multiplexed connections.
    "control_path": "/tmp/annunciator-public-ssh-%C",
    // Seconds a power command may take.
    "command_timeout_s": 20
  },
  // Events. The in-memory event log behind the Log view and phone alerts.
  "events": {
    // Events kept in memory.
    "keep": 200,
    // Events included in each /api/state reply.
    "recent": 40
  },
  // Speed tests. Optional internet speed tests against Cloudflare's public endpoints. Off until
  // routes lists one.
  "speedtest": {
    // Hours between scheduled runs.
    "interval_h": 3,
    // Minimum seconds after start-up before the first scheduled run.
    "first_delay_s": 120,
    // Host serving /__down and /__up.
    "host": "speed.cloudflare.com",
    // Download phase time cap.
    "download_limit_s": 8,
    // Download phase byte cap.
    "download_limit_bytes": 50000000,
    // Upload phase time cap.
    "upload_limit_s": 6,
    // Upload phase byte cap.
    "upload_limit_bytes": 20000000,
    // Results kept per route.
    "keep": 48,
    // Where results persist. Default: <data_dir>/speedtest.json.
    "history_file": null,
    // Each route runs one test; add iface to bind a Linux interface. Empty: speed tests off.
    "routes": [
      // { "id": "default", "label": "Internet connection" }
    ]
  },
  // Memory router link. Optional. When present, the dashboard shows the local memory router's
  // usage. The router itself is configured in its own file (see below). Remove this object (or
  // set null) to hide the memory card.
  "memory_router": {
    // Router URL; must be on this computer (127.0.0.1 or localhost).
    "url": "http://127.0.0.1:18170",
    // Router access key. Default: <data_dir>/memory/router.key.
    "key_file": null,
    // Seconds to wait for the router when building /api/state.
    "timeout_s": 1.5
  },
  // List of machines: a computer checked with a TCP connect. Example values use documentation
  // addresses; replace them with your own.
  "machines": [
    {
      // Unique machine ID (letters, digits, _, -).
      "id": "workstation",
      // Display name. Default: the ID.
      "name": "Workstation",
      // Hostname or IP address the server connects to.
      "ip": "192.0.2.10",
      // TCP port to probe.
      "port": 22,
      // Free-text role shown in details.
      "role": "Development",
      // Operating-system label shown in details.
      "os": "Linux",
      // Decides the power command.
      "platform": "linux",
      // SSH target (user@host or an alias) for containers and power. Unset means local.
      "ssh": "monitor@192.0.2.10",
      // local, ssh:TARGET (Linux) or winps:TARGET (Windows). Unset: availability only.
      "telemetry": "ssh:monitor@192.0.2.10",
      // Container runtime to inventory.
      "containers": "docker",
      // MAC address for Wake-on-LAN.
      "mac": "00:00:5e:00:53:01",
      // Written by the wizard: the account its target script is for. Not used at runtime.
      "setup_user": null
    }
  ],
  // List of services: an HTTP endpoint checked with a GET. Example values use documentation
  // addresses; replace them with your own.
  "services": [
    {
      // Unique service ID.
      "id": "photos",
      // Display name. Default: the ID.
      "name": "Photo library",
      // URL the server requests. Any answer below HTTP 500 counts as up.
      "probe": "http://192.0.2.10:8080/health",
      // URL a browser or phone opens.
      "open": "https://photos.example.com/",
      // ID of the machine this service runs on.
      "host": "workstation",
      // Free-text description.
      "description": "Photo service"
    }
  ]
}
