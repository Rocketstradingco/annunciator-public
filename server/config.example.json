{
  "port": 18160,
  "bind": "127.0.0.1",
  "interval_s": 10,
  "history": 90,
  "branding": {
    "name": "Annunciator",
    "subtitle": "SYSTEM TELEMETRY",
    "accent": "#dc6b2f"
  },
  "allow_controls": false,
  "wake_broadcast": "255.255.255.255",
  "speedtest": {
    "interval_h": 3,
    "routes": []
  },
  "machines": [
    {
      "id": "monitor",
      "name": "Monitor server",
      "role": "This installation",
      "os": "Linux",
      "ip": "127.0.0.1",
      "port": 18160,
      "telemetry": "local",
      "platform": "linux"
    }
  ],
  "services": [
    {
      "id": "dashboard",
      "name": "Dashboard API",
      "host": "monitor",
      "description": "This Annunciator installation",
      "probe": "http://127.0.0.1:18160/api/health",
      "open": "http://127.0.0.1:18160/"
    }
  ]
}
